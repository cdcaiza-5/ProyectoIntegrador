# STEGO — todas las variables del contrato 7 (§3). Ningún valor real aquí.

STEGO_HTTP_PORT=8081

DB_HOST=db
DB_PORT=5432
DB_NAME=stego
DB_USER=stego_app
DB_PASSWORD=cambiame-stego-app

# STEGO nunca guarda la clave privada: valida por JWKS.
STEGO_AUTH_BASE_URL=http://auth:8080
STEGO_AUTH_JWKS_URL=http://auth:8080/.well-known/jwks.json
STEGO_AUTH_JWKS_TIMEOUT_MS=1500

STEGO_SERVICE_CLIENT_ID=stego
STEGO_SERVICE_CLIENT_SECRET=cambiame-cliente-stego
STEGO_SERVICE_TOKEN_REFRESH_SECONDS=240
STEGO_AUTHZ_TIMEOUT_MS=2000

STEGO_MAX_UPLOAD_BYTES=5242880
STEGO_ALLOWED_EXTENSIONS=png,bmp
STEGO_ALLOWED_CONTENT_TYPES=image/png,image/bmp,image/x-ms-bmp
STEGO_MAX_IMAGE_DIMENSION=10000
STEGO_MAX_IMAGE_PIXELS=25000000
STEGO_LSB_ANOMALY_THRESHOLD=0.75

STEGO_STORAGE_QUARANTINE_PATH=/var/stego/quarantine
STEGO_STORAGE_RETENTION_DAYS=7
STEGO_LOG_LEVEL=info

# --- Opcionales de STEGO (no están en el contrato 7 §3) ---------------------
# Tienen valores por defecto iguales a los del contrato 1/2 y a los de este
# archivo, así que no es necesario definirlas. Se incluyen para poder ajustar
# el comportamiento sin tocar código.
#
# Prefijo de la API pública (contrato 7 §5).
#API_V1_STR=/api/v1
# Claims que STEGO exige al access token del usuario (contrato 1 §2).
#STEGO_JWT_ISSUER=auth-service
#STEGO_JWT_AUDIENCE=stego-api
#STEGO_JWT_LEEWAY_SECONDS=60
# Caché del JWKS: se refresca al expirar o al aparecer un `kid` desconocido.
#STEGO_JWKS_CACHE_SECONDS=300
# Renovación anticipada del token de servicio (el contrato fija 60 s de margen).
#STEGO_SERVICE_TOKEN_MIN_REMAINING_SECONDS=60
# Umbrales de evidencia del analizador: por debajo del mínimo de píxeles o con
# una paleta de colores muy reducida el resultado es `no_concluyentes`.
#STEGO_MIN_ANALYSIS_PIXELS=16384
#STEGO_MIN_PALETTE_COLORS=16
