# STEGO — todas las variables del contrato 7 (§3). Ningún valor real aquí.

STEGO_HTTP_PORT=8081

DB_HOST=db
DB_PORT=5432
DB_NAME=stego
DB_USER=stego_app
DB_PASSWORD=cambiame-stego-app

# STEGO nunca guarda la clave privada: valida por JWKS.
STEGO_AUTH_BASE_URL=http://auth:8080
STEGO_AUTH_JWKS_URL=http://auth:8080/.well-known/jwks.json
STEGO_AUTH_JWKS_TIMEOUT_MS=1500

STEGO_SERVICE_CLIENT_ID=stego
STEGO_SERVICE_CLIENT_SECRET=cambiame-cliente-stego
STEGO_SERVICE_TOKEN_REFRESH_SECONDS=240
STEGO_AUTHZ_TIMEOUT_MS=2000

STEGO_MAX_UPLOAD_BYTES=5242880
STEGO_ALLOWED_EXTENSIONS=png,bmp
STEGO_ALLOWED_CONTENT_TYPES=image/png,image/bmp,image/x-ms-bmp
STEGO_MAX_IMAGE_DIMENSION=10000
STEGO_MAX_IMAGE_PIXELS=25000000
STEGO_LSB_ANOMALY_THRESHOLD=0.75

STEGO_STORAGE_QUARANTINE_PATH=/var/stego/quarantine
STEGO_STORAGE_RETENTION_DAYS=7
STEGO_LOG_LEVEL=info
