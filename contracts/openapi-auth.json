                    "username",
                    "email",
                    "status",
                    "roles"
                ],
                "title": "ProfileOut"
            },
            "RoleCreate": {
                "properties": {
                    "name": {
                        "type": "string",
                        "pattern": "^[A-Z][A-Z0-9_]{2,31}$",
