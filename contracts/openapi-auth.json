    "components": {
        "schemas": {
            "AuthzCheckRequest": {
                "properties": {
                    "subject_token": {
                        "type": "string",
                        "maxLength": 4096,
                        "minLength": 1,
                        "title": "Subject Token"
                    },
                    "action": {
                        "type": "string",
                        "maxLength": 64,
                        "minLength": 1,
                        "title": "Action"
                    },
                    "resource_id": {
                        "anyOf": [
                            {
                                "type": "string",
                                "format": "uuid"
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "title": "Resource Id"
                    }
                },
                "type": "object",
                "required": [
                    "subject_token",
                    "action"
                ],
                "title": "AuthzCheckRequest"
            },
            "AuthzCheckResponse": {
                "properties": {
                    "decision_id": {
                        "type": "string",
                        "format": "uuid",
                        "title": "Decision Id"
                    },
                    "subject_id": {
                        "anyOf": [
                            {
                                "type": "string",
                                "format": "uuid"
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "title": "Subject Id"
                    },
                    "action": {
                        "type": "string",
                        "title": "Action"
                    },
                    "resource_id": {
                        "anyOf": [
                            {
                                "type": "string",
                                "format": "uuid"
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "title": "Resource Id"
                    },
                    "allowed": {
                        "type": "boolean",
                        "title": "Allowed"
                    },
                    "reason": {
                        "type": "string",
                        "title": "Reason"
                    },
                    "roles": {
                        "items": {
                            "type": "string"
                        },
                        "type": "array",
                        "title": "Roles"
                    },
                    "decided_at": {
                        "type": "string",
                        "title": "Decided At"
                    },
                    "decision_ttl_seconds": {
                        "type": "integer",
                        "title": "Decision Ttl Seconds"
                    }
                },
                "type": "object",
                "required": [
                    "decision_id",
                    "subject_id",
                    "action",
                    "resource_id",
                    "allowed",
                    "reason",
                    "roles",
                    "decided_at",
                    "decision_ttl_seconds"
                ],
                "title": "AuthzCheckResponse"
            },
