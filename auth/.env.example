# AUTH — todas las variables del contrato 7 (§2). Ningún valor real aquí.

AUTH_HTTP_PORT=8080

DB_HOST=db
DB_PORT=5432
DB_NAME=auth
DB_USER=auth_app
DB_PASSWORD=cambiame-auth-app

# Las claves llegan como secretos de Compose a /run/secrets (modo 0444).
AUTH_JWT_PRIVATE_KEY_PATH=/run/secrets/jwt_private.pem
AUTH_JWT_PUBLIC_KEY_PATH=/run/secrets/jwt_public.pem
AUTH_JWT_KID=auth-2026-11
AUTH_JWT_ISSUER=auth-service
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_AUDIENCES=auth-api,stego-api

AUTH_SERVICE_TOKEN_TTL_SECONDS=300
AUTH_SERVICE_CLIENT_ID=stego
AUTH_SERVICE_CLIENT_SECRET=cambiame-cliente-stego
AUTH_AUTHZ_DECISION_TTL_SECONDS=30

AUTH_LOGIN_RATE_LIMIT_PER_MINUTE=5
AUTH_LOG_LEVEL=info
