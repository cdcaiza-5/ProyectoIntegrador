# Infraestructura — solo lo que consume docker-compose.yml.
#
# Este archivo NO configura los servicios: cada uno lee el suyo
# (auth/.env, stego/.env). Aquí van únicamente los secretos que necesita
# la creación de las dos bases.
#
# Los valores de AUTH_DB_PASSWORD y STEGO_DB_PASSWORD deben ser idénticos a
# DB_PASSWORD en auth/.env y stego/.env. ./scripts/check-env.sh lo verifica.

POSTGRES_SUPERUSER_PASSWORD=cambiame-superusuario
AUTH_DB_PASSWORD=cambiame-auth-app
STEGO_DB_PASSWORD=cambiame-stego-app
