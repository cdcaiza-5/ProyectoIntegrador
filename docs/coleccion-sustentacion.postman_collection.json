          ]
        },
        {
          "name": "6.3 · el MISMO JWT ahora → 403",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{beto_token}}"
              }
            ],
            "url": "{{base_url_stego}}/api/v1/steganography/analyze",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": "samples/sample-clean.png"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 403', () => pm.response.to.have.status(403));",
                  "const b = pm.response.code === 204 ? {} : pm.response.json();",
                  "pm.test('el token no expiró: sigue vigente', () => {",
                  "  const p = JSON.parse(atob(pm.collectionVariables.get('beto_token').split('.')[1]));",
                  "  pm.expect(p.exp * 1000).to.be.greaterThan(Date.now());",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Paso 7 · AUTH caído (manual)",
      "description": "Este paso no puede automatizarse dentro de una corrida: hay que parar un contenedor a mitad. En una terminal, con el stack levantado:\n\n    docker compose stop auth\n    curl -i -X POST http://localhost:8081/api/v1/steganography/analyze \\\n      -H 'Authorization: Bearer <token de ana>' -F 'file=@samples/sample-clean.png'\n    docker compose start auth\n\nEsperado: 503 AUTHORIZATION_UNAVAILABLE y ninguna fila nueva en stego.analyses.",
      "item": []
    },
    {
      "name": "Paso 8 · Imagen de referencia frente a imagen con carga LSB",
      "description": "El detector separa una imagen natural de su gemela con el LSB sustituido.",
      "item": [
        {
          "name": "8.1 · imagen de referencia",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{ana_token}}"
              }
            ],
            "url": "{{base_url_stego}}/api/v1/steganography/analyze",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": "samples/sample-clean.png"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
                  "const b = pm.response.code === 204 ? {} : pm.response.json();",
                  "pm.collectionVariables.set('clean_score', b.indicators.anomaly_score);",
                  "pm.test('sin indicios', () => pm.expect(['sin_indicios','no_concluyentes']).to.include(b.status));",
                  "pm.test('limitations no está vacío', () => pm.expect(b.limitations.trim()).to.not.be.empty);"
                ]
              }
            }
          ]
        },
        {
          "name": "8.2 · imagen con carga LSB",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{ana_token}}"
              }
            ],
            "url": "{{base_url_stego}}/api/v1/steganography/analyze",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": "samples/sample-lsb.png"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
                  "const b = pm.response.code === 204 ? {} : pm.response.json();",
                  "pm.test('marcada como sospechosa', () => pm.expect(b.status).to.eql('sospechosos'));",
                  "pm.test('acción de cuarentena', () => pm.expect(b.action).to.eql('cuarentena'));",
                  "pm.test('puntúa más alto que la de referencia', () =>",
                  "  pm.expect(b.indicators.anomaly_score).to.be.greaterThan(pm.collectionVariables.get('clean_score')));"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
