{
  "info": {
    "name": "Sustentación — Backend V1 (AUTH + STEGO)",
    "description": "Un folder por cada paso que exige el enunciado (§3), en su orden.\n\nEjecutar desde la raíz del repositorio: `newman run docs/coleccion-sustentacion.postman_collection.json`\n\nEl paso 7 es el único manual: exige parar AUTH a mitad de la demostración.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url_auth",
      "value": "http://localhost:8080"
    },
    {
      "key": "base_url_stego",
      "value": "http://localhost:8081"
    },
    {
      "key": "admin_identifier",
      "value": "admin"
    },
    {
      "key": "admin_password",
      "value": "AdminSegura2026!"
    },
    {
      "key": "admin_token",
      "value": ""
    },
    {
      "key": "ana_token",
      "value": ""
    },
    {
      "key": "beto_token",
      "value": ""
    },
    {
      "key": "carla_token",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Paso 1 · Cada servicio responde desde su propia API",
      "description": "Dos procesos, dos imágenes, dos puertos. Ninguno depende del otro para arrancar.",
      "item": [
        {
          "name": "1.1 · health de AUTH",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url_auth}}/health"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "const b = pm.response.code === 204 ? {} : pm.response.json();",
                  "pm.test('se identifica como auth', () => pm.expect(b.service).to.eql('auth'));"
                ]
              }
            }
          ]
        },
        {
          "name": "1.2 · health de STEGO",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url_stego}}/health"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "const b = pm.response.code === 204 ? {} : pm.response.json();",
                  "pm.test('se identifica como stego', () => pm.expect(b.service).to.eql('stego'));"
                ]
              }
            }
          ]
        },
        {
          "name": "1.3 · JWKS de AUTH (solo material público)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url_auth}}/.well-known/jwks.json"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "const b = pm.response.code === 204 ? {} : pm.response.json();",
                  "pm.test('expone una clave RSA con kid', () => {",
                  "  pm.expect(b.keys[0].kty).to.eql('RSA'); pm.expect(b.keys[0].kid).to.be.a('string');",
                  "});",
                  "pm.test('no expone la parte privada', () => pm.expect(b.keys[0]).to.not.have.property('d'));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
