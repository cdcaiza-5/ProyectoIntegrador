{
  "info": {
    "name": "Backend V1 — AUTH + STEGO",
    "description": "Colección del contrato 4, para ejecutarse de arriba abajo con `newman run docs/coleccion-rest.postman_collection.json` desde la raíz del repositorio (la petición 11 sube samples/sample-clean.png). T08 (AUTH caído) queda fuera: exige parar un contenedor a mitad del recorrido; su evidencia está en evidence/T08-auth-caido.txt.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url_auth",
      "value": "http://localhost:8080"
    },
    {
      "key": "base_url_stego",
      "value": "http://localhost:8081"
    },
    {
      "key": "admin_identifier",
      "value": "admin"
    },
    {
      "key": "admin_password",
      "value": ""
    },
    {
      "key": "service_secret",
      "value": ""
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "service_token",
      "value": ""
    },
    {
      "key": "user_id",
      "value": ""
    },
    {
      "key": "role_id",
      "value": ""
    },
    {
      "key": "assignment_id",
      "value": ""
    },
    {
      "key": "analysis_id",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "01 · health AUTH",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url_auth}}/health"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('01 · health AUTH: HTTP 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "02 · JWKS público",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url_auth}}/.well-known/jwks.json"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('02 · JWKS público: HTTP 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "03 · login ADMIN",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url_auth}}/api/v1/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"identifier\": \"{{admin_identifier}}\",\n  \"password\": \"{{admin_password}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('03 · login ADMIN: HTTP 200', () => pm.response.to.have.status(200));",
              "const b = pm.response.json(); pm.collectionVariables.set('token', b.access_token);"
            ]
          }
        }
      ]
    },
    {
      "name": "04 · login inválido",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url_auth}}/api/v1/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"identifier\": \"no-existe.{{$timestamp}}\",\n  \"password\": \"clave-incorrecta\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('04 · login inválido: HTTP 401', () => pm.response.to.have.status(401));"
            ]
          }
        }
      ]
    },
    {
      "name": "05 · perfil ADMIN",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{base_url_auth}}/api/v1/auth/profile"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('05 · perfil ADMIN: HTTP 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "06 · roles (captura ANALYST)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{base_url_auth}}/api/v1/roles?limit=100"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('06 · roles (captura ANALYST): HTTP 200', () => pm.response.to.have.status(200));",
              "const b = pm.response.json(); pm.collectionVariables.set('role_id', b.items.find(r => r.name === 'ANALYST').id);"
            ]
          }
        }
      ]
    },
    {
      "name": "07 · crear usuario",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{base_url_auth}}/api/v1/users",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"ana.postman.{{$timestamp}}\",\n  \"email\": \"ana.postman.{{$timestamp}}@espe.edu.ec\",\n  \"password\": \"AnaSegura2026!\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('07 · crear usuario: HTTP 201', () => pm.response.to.have.status(201));",
              "const b = pm.response.json(); pm.collectionVariables.set('user_id', b.id);"
            ]
          }
        }
      ]
    },
    {
      "name": "08 · asignar ANALYST",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{base_url_auth}}/api/v1/user-roles",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"user_id\": \"{{user_id}}\",\n  \"role_id\": \"{{role_id}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('08 · asignar ANALYST: HTTP 201', () => pm.response.to.have.status(201));",
              "const b = pm.response.json(); pm.collectionVariables.set('assignment_id', b.id);"
            ]
          }
        }
      ]
    },
    {
      "name": "09 · asignación duplicada (T06)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{base_url_auth}}/api/v1/user-roles",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"user_id\": \"{{user_id}}\",\n  \"role_id\": \"{{role_id}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('09 · asignación duplicada (T06): HTTP 409', () => pm.response.to.have.status(409));"
            ]
          }
        }
      ]
    },
    {
      "name": "10 · token de servicio",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url_auth}}/internal/service-token",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"client_id\": \"stego\",\n  \"client_secret\": \"{{service_secret}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('10 · token de servicio: HTTP 200', () => pm.response.to.have.status(200));",
              "const b = pm.response.json(); pm.collectionVariables.set('service_token', b.access_token);"
            ]
          }
        }
      ]
    },
    {
      "name": "11 · análisis de una imagen limpia",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{base_url_stego}}/api/v1/steganography/analyze",
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "file",
              "type": "file",
              "src": "samples/sample-clean.png"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('11 · análisis de una imagen limpia: HTTP 201', () => pm.response.to.have.status(201));",
              "const b = pm.response.json(); pm.collectionVariables.set('analysis_id', b.analysis_id);"
            ]
          }
        }
      ]
    },
    {
      "name": "12 · leer el resultado",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{base_url_stego}}/api/v1/steganography/results/{{analysis_id}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('12 · leer el resultado: HTTP 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "13 · sin token",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url_auth}}/api/v1/users"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('13 · sin token: HTTP 401', () => pm.response.to.have.status(401));"
            ]
          }
        }
      ]
    },
    {
      "name": "14 · token manipulado",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer no.es.un.jwt"
          }
        ],
        "url": "{{base_url_auth}}/api/v1/users"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('14 · token manipulado: HTTP 401', () => pm.response.to.have.status(401));"
            ]
          }
        }
      ]
    },
    {
      "name": "15 · autorización interna",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{service_token}}"
          }
        ],
        "url": "{{base_url_auth}}/internal/authorization/check",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"subject_token\": \"{{token}}\",\n  \"action\": \"steganography.analyze\",\n  \"resource_id\": null\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('15 · autorización interna: HTTP 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "16 · logout",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{base_url_auth}}/api/v1/auth/logout"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('16 · logout: HTTP 204', () => pm.response.to.have.status(204));"
            ]
          }
        }
      ]
    },
    {
      "name": "17 · token revocado tras logout",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{base_url_auth}}/api/v1/auth/profile"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('17 · token revocado tras logout: HTTP 401', () => pm.response.to.have.status(401));"
            ]
          }
        }
      ]
    }
  ]
}
